{
  "name": "visualping-clone",
  "version": "1.0.0",
  "description": "A Node.js backend clone of Visualping.io - monitors web pages for content changes on a schedule and keeps a diff history.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "puppeteer": "^25.4.0"
  },
  "allowScripts": {
    "puppeteer@25.4.0": true
  }
}
